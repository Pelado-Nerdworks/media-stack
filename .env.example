# ─── Media Stack ─────────────────────────────────────────────────────────────
# Copiá este archivo como `.env` y editá los valores si querés mover
# las carpetas de configuración o de datos fuera del directorio del compose.
#
# Defaults apuntan a `./config` y `./data` relativos a este archivo, igual
# que el comportamiento anterior (backward-compatible).
#
# Ejemplos de paths absolutos:
#   CONFIG_DIR=/srv/media-stack/config
#   DATA_DIR=/srv/media-stack/data
#
# Si cambiás CONFIG_DIR o DATA_DIR, mové también el contenido existente
# (rsync -av ./config <nuevo_CONFIG_DIR>/) antes de hacer `docker compose up`.
# El script `scripts/configure-base-urls.sh` sigue funcionando igual porque
# trabaja dentro de los containers, no del host.

# Directorio de configs (persistente). Cada app guarda sus settings acá.
CONFIG_DIR=./config

# Directorio de datos (bibliotecas + descargas).
DATA_DIR=./data
